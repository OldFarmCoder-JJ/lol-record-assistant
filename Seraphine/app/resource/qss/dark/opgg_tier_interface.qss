TierListWidget {
    border: 1px solid rgb(60, 60, 60);
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.051);
}

TierListWidget {
    background-color: transparent;
}

ListTitleBar {
    border: 1px solid rgb(60, 60, 60);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-top: none;
    border-left: none;
    border-right: none;
    background-color: rgba(255, 255, 255, 0.051);
}

#scrollArea {
    border: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(185, 185, 185, 0.051);
}

#scrollWidget {
    background-color: transparent;
}

ListItem {
    border: 1px solid rgb(60, 60, 60);
    border-radius: 6px;
    background-color: transparent;
}

#countersLabel,
#counterLabel,
#championLabel {
    color: white;
    font: 14px 'Microsoft YaHei', 'Segoe UI';
    padding: 0;
}

#favoriteButton {
    background: transparent;
    color: #9baabc;
    border: 1px solid transparent;
    border-radius: 6px;
    font: 18px 'Segoe UI Symbol', 'Microsoft YaHei';
}
#favoriteButton[favorite="true"] { color: #71b9f3; }
#favoriteButton:hover { background: #29435b; color: #91ccfa; }
#favoriteButton:focus { border: 1px solid #71b9f3; }
#favoriteButton:disabled { color: #687482; }
#rankingDetail { color: #7cc5ba; font: 10px 'Microsoft YaHei', 'Segoe UI'; }
