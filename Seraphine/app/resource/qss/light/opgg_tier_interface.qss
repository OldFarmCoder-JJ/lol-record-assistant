TierListWidget {
    border: 1px solid rgba(0, 0, 0, 0.095);
    border-radius: 6px;
    background-color: rgba(245, 245, 245, 0.334);
}

TierListWidget {
    background-color: transparent;
}

ListTitleBar {
    border: 1px solid rgba(0, 0, 0, 0.095);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-top: none;
    border-left: none;
    border-right: none;
    background-color: rgba(245, 245, 245, 0.6);
}

#scrollArea {
    border: none;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(245, 245, 245, 0.55);
}

#scrollWidget {
    background-color: transparent;
}

ListItem {
    border: 1px solid rgba(0, 0, 0, 0.095);
    border-radius: 6px;
}

#countersLabel,
#counterLabel,
#championLabel {
    color: black;
    font: 14px 'Microsoft YaHei', 'Segoe UI';
    padding: 0;
}

#favoriteButton {
    background: transparent;
    color: #707e8e;
    border: 1px solid transparent;
    border-radius: 6px;
    font: 18px 'Segoe UI Symbol', 'Microsoft YaHei';
}
#favoriteButton[favorite="true"] { color: #1675b9; }
#favoriteButton:hover { background: #dcecf8; color: #1675b9; }
#favoriteButton:focus { border: 1px solid #1675b9; }
#favoriteButton:disabled { color: #a7adb5; }
#rankingDetail { color: #26776f; font: 10px 'Microsoft YaHei', 'Segoe UI'; }
